#!/usr/bin/env python3
"""Unified Toyota diagnostic CLI."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if ROOT not in sys.path:
  sys.path.insert(0, ROOT)

# Local development uses the repo venv; AGNOS normally already resolves python3 to
# /usr/local/venv/bin/python3. Re-exec locally only when opendbc is unavailable.
try:
  import opendbc  # noqa: F401
except ImportError:
  venv_python = os.path.join(ROOT, ".venv", "bin", "python")
  if os.path.isfile(venv_python) and os.path.realpath(sys.executable) != os.path.realpath(venv_python):
    os.execv(venv_python, [venv_python, os.path.realpath(__file__), *sys.argv[1:]])

from tools.toyota_diag.cli import main

if __name__ == "__main__":
  sys.exit(main())
